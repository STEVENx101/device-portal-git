<%@ page pageEncoding="UTF-8" %>
<%@ page import="com.fintrex.deviceportal.dto.Screen" %>
<%@ page import="com.fintrex.deviceportal.dto.User" %>
<%@ page import="java.util.List" %>
<%
    List<Screen> userScreens = (List<Screen>) session.getAttribute("permittedScreens");
    boolean hasDashboard = false;
    boolean hasDeviceFinance = false;
    boolean hasUserManagement = false;
    boolean hasPortfolio = false;
    boolean hasClientReport = false;
    boolean hasTransactionReport = false;
    boolean hasAgreementReport = false;
    boolean hasReportLogs = false;
    boolean hasArrearsReport = false;
    boolean hasNpaReport = false;
    boolean hasNearingNpaReport = false;
    boolean hasDuplicateLoansReport = false;
    boolean hasUnlockArrearsReport = false;
    boolean hasLockNoArrearsReport = false;
    boolean hasOneRentalReport = false;
    boolean hasSettledReport = false;
    boolean hasMaturedLowBalanceReport = false;
    boolean hasMultiplePaymentsReport = false;
    boolean hasDpdBucketReport = false;
    boolean hasVendorPaymentsReport = false;
    boolean hasVendorPaymentsExceptionReport = false;
    boolean canDownloadReports = false;
    boolean hasBulkUpload = false;
    boolean hasBulkApprove = false;
    if (userScreens != null) {
        for (Screen s : userScreens) {
            if (s.getPath().equalsIgnoreCase("/dashboard")) hasDashboard = true;
            if (s.getPath().equalsIgnoreCase("/mobile")) hasDeviceFinance = true;
            if (s.getPath().equalsIgnoreCase("/user-management")) hasUserManagement = true;
            if (s.getPath().equalsIgnoreCase("/portfolio")) hasPortfolio = true;
            if (s.getPath().equalsIgnoreCase("/client")) hasClientReport = true;
            if (s.getPath().equalsIgnoreCase("/transaction")) hasTransactionReport = true;
            if (s.getPath().equalsIgnoreCase("/agreement")) hasAgreementReport = true;
            if (s.getPath().equalsIgnoreCase("/report-logs")) hasReportLogs = true;
            if (s.getPath().equalsIgnoreCase("/arrears-report")) hasArrearsReport = true;
            if (s.getPath().equalsIgnoreCase("/npa-report")) hasNpaReport = true;
            if (s.getPath().equalsIgnoreCase("/nearing-npa-report")) hasNearingNpaReport = true;
            if (s.getPath().equalsIgnoreCase("/duplicate-loans-report")) hasDuplicateLoansReport = true;
            if (s.getPath().equalsIgnoreCase("/unlock-arrears-report")) hasUnlockArrearsReport = true;
            if (s.getPath().equalsIgnoreCase("/lock-no-arrears-report")) hasLockNoArrearsReport = true;
            if (s.getPath().equalsIgnoreCase("/one-rental-report")) hasOneRentalReport = true;
            if (s.getPath().equalsIgnoreCase("/settled-report")) hasSettledReport = true;
            if (s.getPath().equalsIgnoreCase("/matured-low-balance-report")) hasMaturedLowBalanceReport = true;
            if (s.getPath().equalsIgnoreCase("/multiple-payments-report")) hasMultiplePaymentsReport = true;
            if (s.getPath().equalsIgnoreCase("/dpd-bucket-report")) hasDpdBucketReport = true;
            if (s.getPath().equalsIgnoreCase("/vendor-payments")) hasVendorPaymentsReport = true;
            if (s.getPath().equalsIgnoreCase("/vendor-payments-exception")) hasVendorPaymentsExceptionReport = true;
            if (s.getPath().equalsIgnoreCase("/download-reports")) canDownloadReports = true;
            if (s.getPath().equalsIgnoreCase("/payments/upload")) hasBulkUpload = true;
            if (s.getPath().equalsIgnoreCase("/payments/approve")) hasBulkApprove = true;
        }
    }
    if (!hasVendorPaymentsExceptionReport && (hasDuplicateLoansReport || hasMaturedLowBalanceReport)) hasVendorPaymentsExceptionReport = true;
    User navbarUser = (User) session.getAttribute("currentUser");
    String navUserName = (navbarUser != null) ? navbarUser.getFullName() : "Guest User";
    String navUserRole = (navbarUser != null) ? navbarUser.getUserTypeName() : "Visitor";
%>
<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap');

/* Caching bypass styling overrides & layout */
html, body, .main, [data-layout="container"], .container-fluid {
    height: 100vh !important;
    max-height: 100vh !important;
    overflow: hidden !important;
}

body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    background-color: #f8fafc !important;
    background-image: none !important;
    color: #1e293b !important;
}

h1, h2, h3, h4, h5, h6, .brand-logo-text {
    font-family: 'Outfit', sans-serif !important;
    font-weight: 700 !important;
}

/* Premium Scrollbars */
::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}
::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 8px;
}
::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 8px;
    border: 1px solid #f1f5f9;
}
::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
}

/* Glassmorphism theme cards to clean white cards */
.card, .glass-card, .modal-content {
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -2px rgba(0, 0, 0, 0.03) !important;
    border-radius: 16px !important;
    color: #1e293b !important;
    transition: box-shadow 0.2s ease-in-out, transform 0.2s ease-in-out;
}

.card:hover {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -4px rgba(0, 0, 0, 0.05) !important;
}

.card-header {
    background-color: #f8fafc !important;
    border-bottom: 1px solid #f1f5f9 !important;
    padding: 1rem 1.25rem !important;
    border-top-left-radius: 16px !important;
    border-top-right-radius: 16px !important;
}

.card-header h5, .card-header h6 {
    margin: 0 !important;
    font-size: 1rem !important;
    color: #1e1b4b !important;
}

/* Data Tables & Regular Tables Styling */
.table {
    margin-bottom: 0 !important;
}
.table thead th {
    background-color: #f8fafc !important;
    color: #475569 !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.06em !important;
    font-size: 0.72rem !important;
    border-bottom: 2px solid #e2e8f0 !important;
    padding: 0.85rem 1rem !important;
}
.table tbody td {
    padding: 0.85rem 1rem !important;
    font-size: 0.82rem !important;
    vertical-align: middle !important;
    color: #334155 !important;
    border-bottom: 1px solid #f1f5f9 !important;
}
.table-hover tbody tr:hover {
    background-color: rgba(99, 102, 241, 0.03) !important;
}

/* Form Controls & Inputs */
.form-control, .form-select {
    padding: 0.6rem 1rem !important;
    font-size: 0.85rem !important;
    border-radius: 10px !important;
    border: 1.5px solid #cbd5e1 !important;
    background-color: #ffffff !important;
    color: #1e293b !important;
    transition: all 0.2s ease-in-out !important;
}
.form-control:focus, .form-select:focus {
    border-color: #6366f1 !important;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12) !important;
}

/* Interactive Buttons */
.btn {
    padding: 0.55rem 1.2rem !important;
    font-size: 0.85rem !important;
    font-weight: 600 !important;
    border-radius: 10px !important;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
}
/* High-specificity overrides to override local page JSP styles */
html body .btn-primary {
    background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%) !important;
    border: none !important;
    color: #ffffff !important;
    box-shadow: 0 4px 10px rgba(79, 70, 229, 0.15) !important;
}
html body .btn-primary:hover,
html body .btn-primary:focus,
html body .btn-primary:active {
    background: linear-gradient(135deg, #4338ca 0%, #4f46e5 100%) !important;
    box-shadow: 0 6px 16px rgba(79, 70, 229, 0.25) !important;
    color: #ffffff !important;
    transform: translateY(-1px);
}
html body .btn-success {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
    border: none !important;
    color: #ffffff !important;
    box-shadow: 0 4px 10px rgba(16, 185, 129, 0.15) !important;
}
html body .btn-success:hover,
html body .btn-success:focus,
html body .btn-success:active {
    background: linear-gradient(135deg, #059669 0%, #047857 100%) !important;
    box-shadow: 0 6px 16px rgba(16, 185, 129, 0.25) !important;
    color: #ffffff !important;
    transform: translateY(-1px);
}
html body .text-primary {
    color: #4f46e5 !important;
}
html body .bg-soft-primary {
    background-color: rgba(79, 70, 229, 0.08) !important;
    color: #4f46e5 !important;
}
html body .bg-primary {
    background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%) !important;
}

/* Choices.js Select Inputs styling override globally */
html body .choices__inner {
    background: #ffffff !important;
    border: 1.5px solid #cbd5e1 !important;
    border-radius: 10px !important;
    min-height: 42px !important;
    padding: 0.35rem 0.75rem !important;
    transition: all 0.2s ease-in-out !important;
}
html body .choices__inner:focus-within {
    border-color: #6366f1 !important;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12) !important;
}
html body .choices__list--multiple .choices__item {
    background-color: #4f46e5 !important;
    border: 1px solid #4f46e5 !important;
    border-radius: 6px !important;
    font-weight: 600 !important;
    font-size: 0.75rem !important;
    color: #ffffff !important;
    padding: 2px 8px !important;
}
html body .choices__list--dropdown {
    background: #ffffff !important;
    border-radius: 10px !important;
    border: 1px solid #cbd5e1 !important;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05) !important;
}

/* Datatable Filters & Pagination styling override globally */
html body .dataTables_wrapper .dataTables_paginate .paginate_button,
html body .pagination .page-item .page-link,
html body .pagination .page-link,
html body .page-item .page-link {
    border-radius: 6px !important;
    border: 1px solid #e2e8f0 !important;
    background: #ffffff !important;
    color: #475569 !important;
    padding: 0.25rem 0.55rem !important;
    margin: 0 1px !important;
    font-size: 0.76rem !important;
    transition: all 0.2s ease-in-out !important;
    display: inline-block !important;
}
html body .dataTables_wrapper .dataTables_paginate .paginate_button.current,
html body .dataTables_wrapper .dataTables_paginate .paginate_button:hover,
html body .pagination .page-item.active .page-link,
html body .pagination .page-link:hover,
html body .page-item.active .page-link {
    background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%) !important;
    color: #ffffff !important;
    border-color: #4f46e5 !important;
}
html body .dataTables_wrapper .dataTables_filter input {
    margin-left: 0.5em !important;
    display: inline-block !important;
    width: auto !important;
    padding: 0.4rem 0.8rem !important;
    border-radius: 8px !important;
    border: 1.5px solid #cbd5e1 !important;
    background-color: #ffffff !important;
    color: #1e293b !important;
}

/* Modern Status Badges & Alerts */
.badge {
    padding: 0.45em 0.85em !important;
    border-radius: 8px !important;
    font-weight: 700 !important;
    font-size: 0.72rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.03em !important;
}
.badge.bg-success {
    background-color: #d1fae5 !important;
    color: #065f46 !important;
}
.badge.bg-danger {
    background-color: #fee2e2 !important;
    color: #991b1b !important;
}
.badge.bg-warning {
    background-color: #fef3c7 !important;
    color: #92400e !important;
}
.badge.bg-info {
    background-color: #e0f2fe !important;
    color: #075985 !important;
}

/* Modal specific customizations */
.modal-header.bg-primary, 
.modal-header.bg-dark, 
.modal-header {
    background: #f8fafc !important;
    border-bottom: 1px solid #e2e8f0 !important;
    color: #1e293b !important;
}

.modal-header .modal-title {
    color: #4f46e5 !important;
    font-weight: 700 !important;
}

.modal-header .btn-close,
.modal-header .btn-close-white {
    filter: invert(1) !important;
}

.modal-footer.bg-light,
.modal-footer {
    background: #f8fafc !important;
    border-top: 1px solid #e2e8f0 !important;
}

.modal-content .form-control, 
.modal-content .form-select, 
.modal-content textarea {
    background: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 8px !important;
    color: #1e293b !important;
}

.modal-content .form-control:focus, 
.modal-content .form-select:focus,
.modal-content textarea:focus {
    border-color: #6366f1 !important;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15) !important;
}

.modal-footer, .card-header, .bg-100 {
    background: #f8fafc !important;
    border-color: #e2e8f0 !important;
}

.table, td, th {
    border-color: #e2e8f0 !important;
    color: #1e293b !important;
}

/* Hide original sidebar */
.navbar-vertical {
    display: none !important;
}

/* Custom Premium Vertical Sidebar Navbar from scratch with hover expand */
.navbar-vertical-modern {
    position: fixed !important;
    left: 10px !important;
    top: 10px !important;
    width: 70px !important;
    height: calc(100vh - 20px) !important;
    background: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 16px !important;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.08) !important;
    z-index: 1000 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    padding: 1.5rem 0.5rem !important;
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    overflow: hidden !important;
}

.navbar-vertical-modern:hover {
    width: 240px !important;
    padding: 1.5rem 1rem !important;
}

/* Hide text elements in collapsed state, show on hover */
.navbar-vertical-modern:not(:hover) .brand-text,
.navbar-vertical-modern:not(:hover) .nav-item-link span:not(.fas),
.navbar-vertical-modern:not(:hover) .nav-label-text,
.navbar-vertical-modern:not(:hover) .dropdown-chevron,
.navbar-vertical-modern:not(:hover) .user-details,
.navbar-vertical-modern:not(:hover) .logout-btn span:not(.fas) {
    display: none !important;
}

/* Center icons when collapsed */
.navbar-vertical-modern:not(:hover) .nav-item-link,
.navbar-vertical-modern:not(:hover) .logout-btn {
    justify-content: center !important;
    padding: 0.7rem 0 !important;
}
.navbar-vertical-modern:not(:hover) .user-info-block {
    justify-content: center !important;
    padding-left: 0 !important;
}

/* Dropdown Custom Styles */
.nav-item-dropdown-custom {
    display: flex;
    flex-direction: column;
    width: 100%;
}
.dropdown-menu-custom {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding-left: 1.5rem;
    margin-top: 4px;
}
.navbar-vertical-modern:not(:hover) .dropdown-menu-custom {
    display: none !important; /* Never show dropdown when collapsed */
}
.nav-item-dropdown-custom.open .dropdown-menu-custom {
    display: flex;
}
.nav-item-dropdown-custom.open .dropdown-chevron {
    transform: rotate(180deg);
}
.dropdown-item-custom {
    color: #64748b !important;
    font-weight: 600 !important;
    padding: 0.5rem 0.8rem !important;
    border-radius: 8px !important;
    text-decoration: none !important;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    transition: all 0.2s ease-in-out;
}
.dropdown-item-custom:hover {
    color: #4f46e5 !important;
    background: rgba(99, 102, 241, 0.1) !important;
}
.dropdown-item-custom.active {
    color: #4f46e5 !important;
    background: rgba(99, 102, 241, 0.15) !important;
}
.dropdown-header-custom {
    color: #000000 !important;
    font-weight: 700 !important;
    font-size: 0.62rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    padding: 0.6rem 0.8rem 0.2rem 0.8rem !important;
    margin-top: 0.4rem;
    user-select: none;
}

/* Submenu Category Styles */
.submenu-group {
    display: flex;
    flex-direction: column;
    width: 100%;
}
.submenu-trigger {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    pointer-events: auto !important;
    padding: 0.6rem 0.8rem !important;
    border-radius: 8px;
    transition: all 0.2s ease-in-out;
}
.submenu-trigger:hover {
    background: rgba(99, 102, 241, 0.05) !important;
    color: #4f46e5 !important;
}
.submenu-chevron {
    font-size: 0.65rem;
    transition: transform 0.2s ease-in-out;
    color: #64748b;
}
.submenu-items {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding-left: 0.5rem;
    margin-top: 2px;
}
.submenu-group.open .submenu-items {
    display: flex;
}
.submenu-group.open .submenu-chevron {
    transform: rotate(180deg);
}
.navbar-vertical-modern:not(:hover) .submenu-trigger {
    display: none !important;
}
.submenu-items .dropdown-item-custom {
    padding-left: 1.5rem !important;
}
.table td, .table th {
    white-space: nowrap !important;
}
.table tbody tr {
    cursor: pointer;
}

.navbar-vertical-modern .brand-section {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 2rem;
    padding-left: 0.5rem;
}

.navbar-vertical-modern .brand-logo-collapsed-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: transparent !important;
    border-radius: 50%;
    padding: 3px;
    overflow: hidden;
}
.navbar-vertical-modern .brand-logo-collapsed {
    width: 100%;
    height: auto;
    object-fit: contain;
}
.navbar-vertical-modern .brand-logo-expanded {
    display: none;
    height: 35px;
    width: auto;
}
.navbar-vertical-modern .brand-logo-text {
    display: none;
    font-size: 1.25rem;
    font-weight: 750;
    color: #4f46e5 !important;
    font-family: 'Outfit', 'Inter', sans-serif;
    align-self: center;
    margin-left: 8px;
    letter-spacing: 0.05em;
    background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.navbar-vertical-modern:hover .brand-logo-text {
    display: inline-block !important;
}

.navbar-vertical-modern:hover .brand-logo-collapsed-circle {
    display: none !important;
}
.navbar-vertical-modern:hover .brand-logo-expanded {
    display: block !important;
}

.navbar-vertical-modern .nav-wrapper-column {
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
}

.navbar-vertical-modern .nav-links-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    padding-right: 4px;
}

/* Custom scrollbar styling for the vertical nav links section */
.navbar-vertical-modern .nav-links-section::-webkit-scrollbar {
    width: 6px;
}
.navbar-vertical-modern .nav-links-section::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.03);
    border-radius: 4px;
}
.navbar-vertical-modern .nav-links-section::-webkit-scrollbar-thumb {
    background: rgba(99, 102, 241, 0.4) !important;
    border-radius: 4px !important;
}
.navbar-vertical-modern .nav-links-section::-webkit-scrollbar-thumb:hover {
    background: rgba(168, 85, 247, 0.7) !important;
}

.navbar-vertical-modern .nav-item-link {
    color: #475569 !important;
    font-weight: 600 !important;
    padding: 0.7rem 0.9rem !important;
    border-radius: 10px !important;
    text-decoration: none !important;
    transition: all 0.2s ease-in-out !important;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
}

.navbar-vertical-modern .nav-item-link:hover {
    color: #4f46e5 !important;
    background: rgba(99, 102, 241, 0.1) !important;
}

.navbar-vertical-modern .nav-item-link.active {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%) !important;
    color: white !important;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25) !important;
}

/* User profile section at the bottom of sidebar */
.navbar-vertical-modern .user-profile-section {
    border-top: 1px solid rgba(226, 232, 240, 0.6);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.navbar-vertical-modern .user-info-block {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 0.25rem;
}

.navbar-vertical-modern .user-details {
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.navbar-vertical-modern .user-name {
    font-weight: 700;
    font-size: 0.85rem;
    color: #1e293b;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.navbar-vertical-modern .user-role {
    font-size: 0.75rem;
    color: #64748b;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.navbar-vertical-modern .logout-btn {
    color: #ef4444 !important;
    font-weight: 600 !important;
    padding: 0.5rem 0.8rem !important;
    border-radius: 8px !important;
    text-decoration: none !important;
    transition: all 0.2s ease-in-out !important;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    background: rgba(239, 68, 68, 0.08) !important;
}

.navbar-vertical-modern .logout-btn:hover {
    background: rgba(239, 68, 68, 0.15) !important;
}

/* Custom tabs matching colors - vibrant gradient */
.nav-tabs .nav-link.active, .nav-pills .nav-link.active {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%) !important;
    color: white !important;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(168, 85, 247, 0.2) !important;
}
.nav-tabs .nav-link.active, 
.nav-pills .nav-link.active,
.navbar-vertical-modern .nav-item-link.active,
.nav-tabs .nav-link.active *, 
.nav-pills .nav-link.active *,
.navbar-vertical-modern .nav-item-link.active * {
    color: #ffffff !important;
}
.nav-tabs .nav-link, .nav-pills .nav-link {
    color: #475569 !important;
    font-weight: 600 !important;
    transition: all 0.2s ease-in-out;
}
.nav-tabs .nav-link:hover, .nav-pills .nav-link:hover {
    background-color: rgba(99, 102, 241, 0.1) !important;
    color: #4f46e5 !important;
}

/* Scrollbar styling - Standard Webkit */
.tab-content::-webkit-scrollbar, .scrollbar::-webkit-scrollbar, .table-responsive::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}
.tab-content::-webkit-scrollbar-track, .scrollbar::-webkit-scrollbar-track, .table-responsive::-webkit-scrollbar-track {
    background: transparent;
}
.tab-content::-webkit-scrollbar-thumb, .scrollbar::-webkit-scrollbar-thumb, .table-responsive::-webkit-scrollbar-thumb {
    background: rgba(99, 102, 241, 0.4) !important;
    border-radius: 4px !important;
}
.tab-content::-webkit-scrollbar-thumb:hover, .scrollbar::-webkit-scrollbar-thumb:hover, .table-responsive::-webkit-scrollbar-thumb:hover {
    background: rgba(168, 85, 247, 0.6) !important;
}

/* Simplebar custom scrollbar overrides */
.simplebar-scrollbar::before {
    background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%) !important;
    opacity: 0.65 !important;
}
.simplebar-scrollbar.simplebar-visible::before {
    opacity: 0.95 !important;
}
.simplebar-track {
    background: transparent !important;
}

/* Layout constraints to fit in one screen */
.content {
    display: flex !important;
    flex-direction: column !important;
    height: calc(100vh - 20px) !important;
    max-height: calc(100vh - 20px) !important;
    overflow: hidden !important;
    padding-bottom: 10px !important;
    margin-left: 90px !important; /* Margined for collapsed modern sidebar (70px + spacing) */
    transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

#detailsCard {
    flex: 0 0 auto;
    margin-bottom: 1rem !important;
}
#tabsCard {
    flex: 1 1 auto;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin-top: 0 !important;
}
#tabsCard .card-body {
    flex: 1 1 auto;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}
#tabsCard .tab-content {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 1rem;
}
#tabsCard .tab-pane {
    height: 100%;
}

.navbar-top {
    margin-bottom: 0.5rem !important;
    display: none !important;
}

/* Specific to user-management list scroll height */
.table-responsive.scrollbar {
    max-height: calc(100vh - 260px) !important;
    overflow-y: auto;
}

/* Background image override for login */
.log-bg {
    background: #f8fafc !important;
}

/* Responsive and scroll styles */
@media (min-width: 992px) {
    .content {
        overflow-y: auto !important;
    }
}

@media (max-width: 991.98px) {
    html, body, .main, [data-layout="container"], .container-fluid {
        height: auto !important;
        max-height: none !important;
        overflow: auto !important;
    }
    
    .navbar-vertical-modern {
        position: static !important;
        width: auto !important;
        height: auto !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        padding: 1rem !important;
        margin: 10px !important;
        gap: 15px !important;
    }

    .navbar-vertical-modern .brand-section {
        margin-bottom: 0 !important;
    }

    .navbar-vertical-modern .nav-links-section {
        flex-direction: row !important;
        flex-wrap: wrap !important;
        gap: 10px !important;
        flex-grow: 1 !important;
    }

    .navbar-vertical-modern .nav-item-link {
        padding: 0.5rem 0.8rem !important;
    }

    .navbar-vertical-modern .user-profile-section {
        border-top: none !important;
        padding-top: 0 !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 15px !important;
    }

    .content {
        height: auto !important;
        max-height: none !important;
        margin-left: 0 !important;
        overflow: visible !important;
        padding: 0 10px 20px 10px !important;
    }

    .table-responsive.scrollbar {
        max-height: none !important;
    }
}

/* Premium Dark Mode Styling Overrides (ui-ux-pro-max) */
html.dark body {
    background-color: #0b0f19 !important;
    background-image: url('<%= request.getContextPath() %>/assets/img/chatgpt_bg.png?v=2') !important;
    background-repeat: no-repeat !important;
    background-position: center center !important;
    background-attachment: fixed !important;
    background-size: cover !important;
    color: #f8fafc !important;
}

html.dark .card:not([class*="gradient-"]), html.dark .glass-card, html.dark .modal-content {
    background: rgba(15, 23, 42, 0.65) !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    color: #f8fafc !important;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5) !important;
}

html.dark .card:not([class*="gradient-"]):hover {
    box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.7) !important;
    border-color: rgba(255, 255, 255, 0.12) !important;
}

html.dark .card:not([class*="gradient-"]) .card-header {
    background-color: rgba(15, 23, 42, 0.8) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
}

html.dark .card-header h5, html.dark .card-header h6 {
    color: #f8fafc !important;
}

html.dark .text-primary {
    color: #f59e0b !important; /* Premium Gold/Amber Accent */
}

html.dark .btn-primary {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%) !important; /* Premium Purple/Violet CTA */
    border: none !important;
    color: #ffffff !important;
    box-shadow: 0 4px 10px rgba(139, 92, 246, 0.3) !important;
}

html.dark .btn-primary:hover,
html.dark .btn-primary:focus,
html.dark .btn-primary:active {
    background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%) !important;
    box-shadow: 0 6px 16px rgba(139, 92, 246, 0.4) !important;
}

html.dark .table thead th {
    background-color: rgba(15, 23, 42, 0.5) !important;
    color: #94a3b8 !important;
    border-bottom: 2px solid rgba(255, 255, 255, 0.08) !important;
}

html.dark .table, html.dark .table tr, html.dark .table tbody td {
    background-color: transparent !important;
    color: #cbd5e1 !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
}

html.dark .table-striped tbody tr:nth-of-type(odd) {
    background-color: rgba(255, 255, 255, 0.02) !important;
}

html.dark .table-striped tbody tr:nth-of-type(even) {
    background-color: transparent !important;
}

html.dark .table-hover tbody tr:hover {
    background-color: rgba(255, 255, 255, 0.04) !important;
}

html.dark .form-control, html.dark .form-select {
    background-color: rgba(15, 23, 42, 0.8) !important;
    border: 1.5px solid rgba(255, 255, 255, 0.1) !important;
    color: #f8fafc !important;
}

html.dark .form-control:focus, html.dark .form-select:focus {
    border-color: #f59e0b !important;
    box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.15) !important;
}

html.dark .navbar-vertical-modern {
    background: rgba(15, 23, 42, 0.8) !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
    border-color: rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5) !important;
}

html.dark .nav-item-link {
    color: #94a3b8 !important;
}

html.dark .nav-item-link:hover {
    color: #f59e0b !important;
    background: rgba(245, 158, 11, 0.08) !important;
}

html.dark .nav-item-link.active {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%) !important;
    color: #ffffff !important;
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.35) !important;
}

html.dark .dropdown-header-custom {
    color: #f8fafc !important;
}

html.dark .dropdown-item-custom {
    color: #94a3b8 !important;
}

html.dark .dropdown-item-custom:hover {
    color: #f59e0b !important;
    background: rgba(245, 158, 11, 0.08) !important;
}

html.dark .dropdown-item-custom.active {
    color: #f59e0b !important;
    background: rgba(245, 158, 11, 0.12) !important;
}

html.dark .submenu-trigger {
    color: #cbd5e1 !important;
}

html.dark .submenu-trigger:hover {
    background: rgba(245, 158, 11, 0.05) !important;
    color: #f59e0b !important;
}

html.dark .user-profile-section {
    border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
}

html.dark .user-name {
    color: #f8fafc !important;
}

html.dark .user-role {
    color: #94a3b8 !important;
}

html.dark .logout-btn {
    color: #ef4444 !important;
}

html.dark .logout-btn:hover {
    background: rgba(239, 68, 68, 0.1) !important;
}

html.dark ::-webkit-scrollbar-track {
    background: #0b0f19;
}

html.dark ::-webkit-scrollbar-thumb {
    background: #1e293b !important;
    border: 1px solid #0b0f19;
}

html.dark ::-webkit-scrollbar-thumb:hover {
    background: #334155 !important;
}

/* Premium Dark Mode DataTables, Pagination, and Dropdowns Overrides */
html.dark .pagination .page-link {
    background-color: rgba(15, 23, 42, 0.6) !important;
    border-color: rgba(255, 255, 255, 0.08) !important;
    color: #cbd5e1 !important;
}

html.dark .pagination .page-item.active .page-link {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%) !important;
    border-color: transparent !important;
    color: #ffffff !important;
}

html.dark .pagination .page-item.disabled .page-link {
    background-color: rgba(15, 23, 42, 0.3) !important;
    border-color: rgba(255, 255, 255, 0.05) !important;
    color: #64748b !important;
}

html.dark .dataTables_info {
    color: #94a3b8 !important;
}

html.dark .dataTables_length, html.dark .dataTables_filter {
    color: #cbd5e1 !important;
}

html.dark select option {
    background-color: #0f172a !important;
    color: #f8fafc !important;
}

html.dark .dropdown-menu {
    background-color: #151a23 !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;
}

html.dark .dropdown-item {
    color: #cbd5e1 !important;
}

html.dark .dropdown-item:hover, html.dark .dropdown-item:focus {
    background-color: rgba(255, 255, 255, 0.05) !important;
    color: #f8fafc !important;
}

/* Direct DataTables Paginate Button Styling overrides */
html.dark .dataTables_wrapper .dataTables_paginate .paginate_button {
    background: rgba(15, 23, 42, 0.6) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    color: #cbd5e1 !important;
    border-radius: 6px !important;
}
html.dark .dataTables_wrapper .dataTables_paginate .paginate_button.current,
html.dark .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%) !important;
    border-color: transparent !important;
    color: #ffffff !important;
}
html.dark .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
html.dark .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover,
html.dark .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:active {
    background-color: rgba(15, 23, 42, 0.3) !important;
    border-color: rgba(255, 255, 255, 0.05) !important;
    color: #64748b !important;
}
html.dark .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
    background: rgba(255, 255, 255, 0.05) !important;
    color: #f8fafc !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
}

/* Contrast helpers for bootstrap text shades in dark mode */
html.dark .text-black, html.dark .text-dark, html.dark .text-900 {
    color: #f8fafc !important;
}
html.dark .text-800 {
    color: #f1f5f9 !important;
}
html.dark .text-700 {
    color: #e2e8f0 !important;
}
html.dark .text-600 {
    color: #cbd5e1 !important;
}
html.dark .text-500 {
    color: #94a3b8 !important;
}

/* Global Premium Glassmorphic Loader Widget & Orb Animations */
.loader-widget {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 20px 50px rgba(0,0,0,0.08);
    border-radius: 20px;
    padding: 25px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}
html.dark .loader-widget {
    background: rgba(15, 23, 42, 0.75) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4) !important;
}

.orb-container {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
}
.orb {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    animation: orb-bounce 1.4s infinite ease-in-out both;
}
html.dark .orb {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;
}
.orb:nth-child(1) { animation-delay: -0.32s; }
.orb:nth-child(2) { animation-delay: -0.16s; }

@keyframes orb-bounce {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
    40% { transform: scale(1.2); opacity: 1; }
}

/* DataTables Processing Loader styling overrides for all reports */
.dataTables_wrapper .dataTables_processing {
    color: transparent !important;
    font-size: 0 !important;
    background: rgba(255, 255, 255, 0.9) !important;
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
    backdrop-filter: blur(10px) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    border-radius: 12px !important;
    padding: 0 !important;
    width: 54px !important;
    height: 54px !important;
    min-width: 54px !important;
    z-index: 1000 !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    margin-left: 0 !important;
    margin-top: 0 !important;
    display: none !important;
    justify-content: center !important;
    align-items: center !important;
}

.dataTables_wrapper .dataTables_processing[style*="display: block"] {
    display: flex !important;
}

html.dark .dataTables_wrapper .dataTables_processing {
    background: rgba(15, 23, 42, 0.85) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4) !important;
}

.dataTables_wrapper .dataTables_processing::after {
    content: "" !important;
    width: 24px !important;
    height: 24px !important;
    border: 3px solid rgba(139, 92, 246, 0.15) !important;
    border-top: 3px solid #8b5cf6 !important;
    border-radius: 50% !important;
    animation: dt-spinner 0.8s linear infinite !important;
    display: block !important;
}

html.dark .dataTables_wrapper .dataTables_processing::after {
    border: 3px solid rgba(245, 158, 11, 0.15) !important;
    border-top: 3px solid #f59e0b !important;
}

@keyframes dt-spinner {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}
</style>

<div class="navbar-vertical-modern">
    <div class="nav-wrapper-column">
        <a class="brand-section" href="<%= request.getContextPath() %>/dashboard">
            <div class="brand-logo-collapsed-circle">
                <img class="brand-logo-collapsed" src="<%= request.getContextPath() %>/assets/img/logo_collapsed.png" alt="Fintrex Icon" />
            </div>
            <img class="brand-logo-expanded" src="<%= request.getContextPath() %>/assets/img/logo.png" alt="Fintrex Logo" />
            <span class="brand-logo-text">Insight</span>
        </a>
        
        <div class="nav-links-section">
            <% if (hasDashboard) { %>
                <a class="nav-item-link" id="nav-dash" href="<%= request.getContextPath() %>/dashboard">
                    <span class="fas fa-chart-pie"></span>
                    <span>Dashboard</span>
                </a>
            <% } %>
            
            <% if (hasDeviceFinance) { %>
                <a class="nav-item-link" id="nav-finance" href="<%= request.getContextPath() %>/mobile">
                    <span class="fas fa-mobile-alt"></span>
                    <span>Facility Information</span>
                </a>
            <% } %>
            
            <% if (hasPortfolio || hasClientReport || hasTransactionReport || hasAgreementReport || hasReportLogs || hasArrearsReport || hasNpaReport || hasNearingNpaReport || hasDpdBucketReport) { %>
                <div class="nav-item-dropdown-custom" id="nav-reports-group">
                    <a class="nav-item-link dropdown-trigger" href="javascript:void(0)" id="nav-reports-trigger">
                        <span class="fas fa-file-invoice-dollar"></span>
                        <span class="nav-label-text">Reports</span>
                        <span class="fas fa-chevron-down ms-auto dropdown-chevron"></span>
                    </a>
                    <div class="dropdown-menu-custom">
                        <div class="submenu-group" id="submenu-general">
                            <div class="dropdown-header-custom submenu-trigger" id="trigger-general">
                                <span>General Reports</span>
                                <span class="fas fa-chevron-down ms-auto submenu-chevron"></span>
                            </div>
                            <div class="submenu-items">
                                <% if (hasPortfolio) { %>
                                <a href="<%= request.getContextPath() %>/portfolio" class="dropdown-item-custom" id="nav-report-portfolio">
                                    Portfolio
                                </a>
                                <% } %>
                                <% if (hasAgreementReport) { %>
                                <a href="<%= request.getContextPath() %>/agreement" class="dropdown-item-custom" id="nav-report-agreement">
                                    Agreement Report
                                </a>
                                <% } %>
                                <% if (hasClientReport) { %>
                                <a href="<%= request.getContextPath() %>/client" class="dropdown-item-custom" id="nav-report-client">
                                    Customer Static Data
                                </a>
                                <% } %>
                                <% if (hasTransactionReport) { %>
                                <a href="<%= request.getContextPath() %>/transaction" class="dropdown-item-custom" id="nav-report-transaction">
                                    Customer Payments
                                </a>
                                <% } %>
                                <% if (hasVendorPaymentsReport) { %>
                                <a href="<%= request.getContextPath() %>/vendor-payments" class="dropdown-item-custom" id="nav-report-vendor-payments">
                                    Vendor Payments
                                </a>
                                <% } %>
                                <% if (hasReportLogs) { %>
                                <a href="<%= request.getContextPath() %>/report-logs" class="dropdown-item-custom" id="nav-report-logs">
                                    Report Logs
                                </a>
                                <% } %>
                            </div>
                        </div>
                        
                        <div class="submenu-group" id="submenu-recovery">
                            <div class="dropdown-header-custom submenu-trigger" id="trigger-recovery">
                                <span>Recovery Reports</span>
                                <span class="fas fa-chevron-down ms-auto submenu-chevron"></span>
                            </div>
                            <div class="submenu-items">
                                <% if (hasArrearsReport) { %>
                                <a href="<%= request.getContextPath() %>/arrears-report" class="dropdown-item-custom" id="nav-report-arrears">
                                    Arrears Report
                                </a>
                                <% } %>
                                <% if (hasNpaReport) { %>
                                <a href="<%= request.getContextPath() %>/npa-report" class="dropdown-item-custom" id="nav-report-npa">
                                    NPA Report
                                </a>
                                <% } %>
                                <% if (hasNearingNpaReport) { %>
                                <a href="<%= request.getContextPath() %>/nearing-npa-report" class="dropdown-item-custom" id="nav-report-nearing-npa">
                                    Nearing NPA Report
                                </a>
                                <% } %>
                                <% if (hasDpdBucketReport) { %>
                                <a href="<%= request.getContextPath() %>/dpd-bucket-report" class="dropdown-item-custom" id="nav-report-dpd-bucket">
                                    DPD Bucket Report
                                </a>
                                <% } %>
                            </div>
                        </div>
                        
                        <div class="submenu-group" id="submenu-exception">
                            <div class="dropdown-header-custom submenu-trigger" id="trigger-exception">
                                <span>Exception Reports</span>
                                <span class="fas fa-chevron-down ms-auto submenu-chevron"></span>
                            </div>
                            <div class="submenu-items">
                                <% if (hasDuplicateLoansReport) { %>
                                <a href="<%= request.getContextPath() %>/duplicate-loans-report" class="dropdown-item-custom" id="nav-report-duplicate-loans">
                                    Duplicate Loans
                                </a>
                                <% } %>
                                <% if (hasUnlockArrearsReport) { %>
                                <a href="<%= request.getContextPath() %>/unlock-arrears-report" class="dropdown-item-custom" id="nav-report-unlock-arrears">
                                    Unlock with Arrears
                                </a>
                                <% } %>
                                <% if (hasLockNoArrearsReport) { %>
                                <a href="<%= request.getContextPath() %>/lock-no-arrears-report" class="dropdown-item-custom" id="nav-report-lock-no-arrears">
                                    Lock with No Arrears
                                </a>
                                <% } %>
                                <% if (hasOneRentalReport) { %>
                                <a href="<%= request.getContextPath() %>/one-rental-report" class="dropdown-item-custom" id="nav-report-one-rental">
                                    Last Rental Remaining
                                </a>
                                <% } %>
                                <% if (hasSettledReport) { %>
                                <a href="<%= request.getContextPath() %>/settled-report" class="dropdown-item-custom" id="nav-report-settled">
                                    Settled & Early Settled
                                </a>
                                <% } %>
                                <% if (hasMaturedLowBalanceReport) { %>
                                <a href="<%= request.getContextPath() %>/matured-low-balance-report" class="dropdown-item-custom" id="nav-report-matured-low-balance">
                                    Matured Low Balance
                                </a>
                                <% } %>
                                <% if (hasMultiplePaymentsReport) { %>
                                <a href="<%= request.getContextPath() %>/multiple-payments-report" class="dropdown-item-custom" id="nav-report-multiple-payments">
                                    Multiple Payments
                                </a>
                                <% } %>
                                <% if (hasVendorPaymentsExceptionReport) { %>
                                <a href="<%= request.getContextPath() %>/vendor-payments-exception" class="dropdown-item-custom" id="nav-report-vendor-payments-exception">
                                    Vendor Payment Exceptions
                                </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (hasBulkUpload || hasBulkApprove) { %>
                <div class="nav-item-dropdown-custom" id="nav-payments-group">
                    <a class="nav-item-link dropdown-trigger" href="javascript:void(0)" id="nav-payments-trigger">
                        <span class="fas fa-wallet"></span>
                        <span class="nav-label-text">Payments</span>
                        <span class="fas fa-chevron-down ms-auto dropdown-chevron"></span>
                    </a>
                    <div class="dropdown-menu-custom">
                        <div class="submenu-group" id="submenu-payments">
                            <div class="submenu-items" style="display: block;">
                                <% if (hasBulkUpload) { %>
                                <a href="<%= request.getContextPath() %>/payments/upload" class="dropdown-item-custom" id="nav-payments-upload">
                                    Bulk Upload
                                </a>
                                <% } %>
                                <% if (hasBulkApprove) { %>
                                <a href="<%= request.getContextPath() %>/payments/approve" class="dropdown-item-custom" id="nav-payments-approve">
                                    Bulk Approve
                                </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

            <% if (hasUserManagement) { %>
                <a class="nav-item-link" id="nav-users" href="<%= request.getContextPath() %>/user-management">
                    <span class="fas fa-users-cog"></span>
                    <span>User Management</span>
                </a>
            <% } %>
        </div>
    </div>
    
    <!-- User Profile details stacked compactly at the bottom -->
    <div class="user-profile-section">
        <div class="user-info-block">
            <img class="rounded-circle" src="<%= request.getContextPath() %>/assets/img/avatar.png" alt="" width="32" />
            <div class="user-details">
                <span class="user-name"><%= navUserName %></span>
                <span class="user-role"><%= navUserRole %></span>
            </div>
        </div>
        <a class="logout-btn" href="<%= request.getContextPath() %>/sso-logout">
            <span class="fas fa-sign-out-alt"></span>
            <span>Logout</span>
        </a>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const path = window.location.pathname;
        const params = new URLSearchParams(window.location.search);
        
        if (path.includes("dashboard")) {
            const el = document.getElementById("nav-dash");
            if (el) el.classList.add("active");
        } else if (path.includes("mobile")) {
            const el = document.getElementById("nav-finance");
            if (el) el.classList.add("active");
        } else if (path.includes("user-management")) {
            const el = document.getElementById("nav-users");
            if (el) el.classList.add("active");
        } else if (path.includes("payments/upload") || path.includes("payments/approve")) {
            const group = document.getElementById("nav-payments-group");
            if (group) group.classList.add("open");
            if (path.includes("payments/upload")) {
                const item = document.getElementById("nav-payments-upload");
                if (item) item.classList.add("active");
            } else if (path.includes("payments/approve")) {
                const item = document.getElementById("nav-payments-approve");
                if (item) item.classList.add("active");
            }
        } else if (path.includes("portfolio") || path.includes("client") || path.includes("transaction") || path.includes("vendor-payments") || path.includes("agreement") || path.includes("report-logs") || path.includes("arrears-report") || path.includes("npa-report") || path.includes("nearing-npa-report") || path.includes("duplicate-loans-report") || path.includes("unlock-arrears-report") || path.includes("lock-no-arrears-report")) {
            const group = document.getElementById("nav-reports-group");
            if (group) group.classList.add("open");
            
            if (path.includes("portfolio")) {
                const item = document.getElementById("nav-report-portfolio");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-general");
                if (sub) sub.classList.add("open");
            } else if (path.includes("agreement")) {
                const item = document.getElementById("nav-report-agreement");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-general");
                if (sub) sub.classList.add("open");
            } else if (path.includes("client")) {
                const item = document.getElementById("nav-report-client");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-general");
                if (sub) sub.classList.add("open");
            } else if (path.includes("vendor-payments-exception")) {
                const item = document.getElementById("nav-report-vendor-payments-exception");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-exception");
                if (sub) sub.classList.add("open");
            } else if (path.includes("vendor-payments")) {
                const item = document.getElementById("nav-report-vendor-payments");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-general");
                if (sub) sub.classList.add("open");
            } else if (path.includes("transaction")) {
                const item = document.getElementById("nav-report-transaction");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-general");
                if (sub) sub.classList.add("open");
            } else if (path.includes("report-logs")) {
                const item = document.getElementById("nav-report-logs");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-general");
                if (sub) sub.classList.add("open");
            } else if (path.includes("arrears-report")) {
                const item = document.getElementById("nav-report-arrears");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-recovery");
                if (sub) sub.classList.add("open");
            } else if (path.includes("npa-report")) {
                const item = document.getElementById("nav-report-npa");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-recovery");
                if (sub) sub.classList.add("open");
            } else if (path.includes("nearing-npa-report")) {
                const item = document.getElementById("nav-report-nearing-npa");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-recovery");
                if (sub) sub.classList.add("open");
            } else if (path.includes("duplicate-loans-report")) {
                const item = document.getElementById("nav-report-duplicate-loans");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-exception");
                if (sub) sub.classList.add("open");
            } else if (path.includes("unlock-arrears-report")) {
                const item = document.getElementById("nav-report-unlock-arrears");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-exception");
                if (sub) sub.classList.add("open");
            } else if (path.includes("lock-no-arrears-report")) {
                const item = document.getElementById("nav-report-lock-no-arrears");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-exception");
                if (sub) sub.classList.add("open");
            } else if (path.includes("one-rental-report")) {
                const item = document.getElementById("nav-report-one-rental");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-exception");
                if (sub) sub.classList.add("open");
            } else if (path.includes("settled-report")) {
                const item = document.getElementById("nav-report-settled");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-exception");
                if (sub) sub.classList.add("open");
            } else if (path.includes("matured-low-balance-report")) {
                const item = document.getElementById("nav-report-matured-low-balance");
                if (item) item.classList.add("active");
                const sub = document.getElementById("submenu-exception");
                if (sub) sub.classList.add("open");
            }
        }

        // Toggle custom dropdown on click
        const trigger = document.getElementById("nav-reports-trigger");
        if (trigger) {
            trigger.addEventListener("click", (e) => {
                e.preventDefault();
                const group = document.getElementById("nav-reports-group");
                if (group) {
                    group.classList.toggle("open");
                }
            });
        }

        const paymentsTrigger = document.getElementById("nav-payments-trigger");
        if (paymentsTrigger) {
            paymentsTrigger.addEventListener("click", (e) => {
                e.preventDefault();
                const group = document.getElementById("nav-payments-group");
                if (group) {
                    group.classList.toggle("open");
                }
            });
        }

        // Toggle submenu dropdowns on click
        const subTriggers = document.querySelectorAll(".submenu-trigger");
        subTriggers.forEach(subTrigger => {
            subTrigger.addEventListener("click", (e) => {
                e.preventDefault();
                e.stopPropagation();
                const parentGroup = subTrigger.closest(".submenu-group");
                if (parentGroup) {
                    parentGroup.classList.toggle("open");
                }
            });
        });
    });
</script>
